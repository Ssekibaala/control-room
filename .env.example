# Copy this file to .env for local testing (never commit the real .env).
# In production (currently Northflank, see DEPLOY.md), set these as
# real Environment Variables/Secrets in the service's dashboard, not in
# a file.

# ---- Flask ----
FLASK_SECRET_KEY=replace-with-a-long-random-string

# ---- Public URL used in links sent by email ----
# REQUIRED on Northflank - unlike Render, it does not auto-inject
# RENDER_EXTERNAL_URL (app.py's public_base_url() and run_import.py's
# _public_base_url() both check for that name specifically, so it just
# won't be there). Leaving this unset doesn't send a broken link, it
# silently SKIPS sending the notification/digest entirely - see
# _public_base_url()'s docstring. Never point this at localhost - it
# goes straight into emailed links a real client clicks from their own
# device.
PUBLIC_BASE_URL=https://your-real-public-domain.example

# ---- Mailbox (mail.teletracfleets.com, standard IMAPS + outbound SMTP) ----
# Both mail_reader.py (IMAP) and mailer.py (outbound SMTP, port 587
# falling back to 465) use this same account. Render's free tier blocks
# every outbound SMTP port, which is why this app is deployed on
# Northflank instead - confirmed live that Northflank's network allows
# outbound 587/465/25 to this host, where Render's did not.
EMAIL_ADDRESS=brandon.b@teletracfleets.com
EMAIL_PASSWORD=the-real-account-password
# This account should ONLY be used for these report subscriptions,
# never a general inbox, since this host doesn't support scoped
# app-passwords, only the real account password.

# ---- Import endpoint security ----
# Generate any long random string, put the SAME value wherever the daily
# import is actually triggered from - a cPanel cron job's curl command
# (see DEPLOY.md), or the legacy Apps Script scheduler
# (apps_script_scheduler.gs). Whoever calls /api/import must send this
# exact value in the X-API-Key header.
IMPORT_API_KEY=replace-with-a-long-random-string

# ---- Cron endpoint security (cPanel/Namecheap deployment) ----
# Same idea as IMPORT_API_KEY, for the two cron-triggered routes that
# replace the in-process poll/digest threads on request-driven hosting
# (see DEPLOY.md's cPanel section): /api/cron/poll-all and
# /api/cron/digest-tick. Not needed if this deployment still runs the
# in-process pollers (Northflank/Render/Docker) instead of cron.
CRON_API_KEY=replace-with-a-long-random-string

# ---- MySQL (accounts/feedback/clients/etc. storage) ----
# See db.py for the schema and scripts/init_db.py to create the tables
# the first time. On Namecheap cPanel: create these via "MySQL
# Databases" in cPanel first (the database name/user Namecheap gives
# you are usually prefixed with your cPanel username, e.g.
# yourusername_controlroom).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=control_room
MYSQL_USER=root
MYSQL_PASSWORD=
# ---- Google Sheets (LEGACY - one-time migration only) ----
# No longer used by the running app (see db.py/db_store.py, which
# replaced sheets_store.py as the live data store). Only needed once,
# to run scripts/export_sheets_to_mysql.py against the OLD Sheet during
# the one-time cutover - see the setup steps at the top of
# sheets_store.py for how to get these two values.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
# FEEDBACK_SHEET_ID=the-id-from-your-google-sheet-url

# ---- MiX Integrate API (live polling, replaces the mailed report ----
# ---- subscriptions - see fleet_logic/adapters/mix_api_client.py) ----
# Client credentials + a real MiX portal login (password grant - MiX's
# Integrate API doesn't support a scoped service account, same
# constraint as the mailbox above). Which organisations get polled and
# how often is configured in data/settings.ini's [mix_api] section, not
# here - these four are just the secret.
MIX_CLIENT_ID=replace-with-your-mix-client-id
MIX_CLIENT_SECRET=replace-with-your-mix-client-secret
MIX_USERNAME=replace-with-your-mix-portal-username
MIX_PASSWORD=replace-with-your-mix-portal-password

# ---- Teletrac Integrate API (live polling, replaces the mailed ----
# ---- "Bulk - Teletrac platform offline report" CSV - see ----
# ---- fleet_logic/adapters/teletrac_api_client.py) ----
# Web API Key / Web Secret Key from Teletrac support (used as a
# password-grant username/password, not a real user login - same
# constraint as MIX_* above). Which clients get polled and how often
# is configured in data/settings.ini's [teletrac_api] section, not
# here - these two are just the secret. Use GET /api/teletrac/clients
# (once this is deployed) to look up the ClientID for "Globe Trotters
# Ltd" to put in settings.ini.
TELETRAC_API_KEY=replace-with-your-teletrac-web-api-key
TELETRAC_API_SECRET=replace-with-your-teletrac-web-secret-key

# ---- FT Cloud OpenAPI (live polling, replaces the mailed "Offline ----
# ---- Vehicle Reports" zip - see ----
# ---- fleet_logic/adapters/ft_cloud_api_client.py) ----
# Unlike the two platforms above there is NO token exchange: FT issues
# a long-lived signature string per tenant and every request carries it
# as the _sign header alongside the numeric _tenantid. Both values come
# from FT support. Which fleets get polled and how often is configured
# in data/settings.ini's [ft_cloud_api] section, not here. Use
# GET /api/ftcloud/fleets to look up the fleetId for "Globe Trotters
# Ltd(GTL)". FT_CLOUD_BASE_URL is optional - the af- (Africa) host is
# the default; the eur- host serves the SAME tenant and data, so it is
# only worth switching for latency.
FT_CLOUD_API_SIGN=replace-with-your-ft-cloud-api-sign
FT_CLOUD_TENANT_ID=replace-with-your-ft-cloud-tenant-id
# FT_CLOUD_BASE_URL=https://af-ftcloud.ifleetvision.com:20501/openapi
#
# FT has NO bulk position endpoint - GPS is a push stream, so
# coordinates otherwise cost one API call per device per poll. This
# app receives that stream on its own /webhook/ftcloud/<secret> route
# (no extra service, it's just another Flask route). FT's subscribe
# API accepts only a callbackUrl with no header or credential, so this
# secret lives IN the URL and is effectively that endpoint's password:
# generate a long random value and treat it like one.
#   python -c "import secrets; print(secrets.token_hex(24))"
FT_CLOUD_WEBHOOK_SECRET=replace-with-a-long-random-string
